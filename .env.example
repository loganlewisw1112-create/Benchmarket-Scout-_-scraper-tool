# Copy to .env.local and adjust. All values are optional; sensible defaults
# are used if unset. See README.md ("Environment variables") for details.

# live | auto | mock — see README "Demo mode"
DEMO_MODE=auto

# Identifies this scraper to Nominatim/Overpass. Use a REAL contact address.
# Do NOT use example.com — their edge networks reject that placeholder domain.
APP_USER_AGENT="BenchmarkScout/0.1 (contact: you@example.org)"

# Where flat-file JSON caches are written (relative to project root).
CACHE_DIR=.cache

# When "true", website audits fetch and respect each site's robots.txt.
STRICT_ROBOTS=false

# ---------------------------------------------------------------------------
# Hosted deployment (Vercel) - see DEPLOY.md
# ---------------------------------------------------------------------------

# On Vercel the project root is read-only; only /tmp is writable. Point the
# flat-file analysis cache there so caching works within a warm instance.
# CACHE_DIR=/tmp/.cache

# Durable store for saved/shareable reports + waitlist. Provision "Vercel KV"
# (Upstash Redis) and these two are injected automatically. Without them,
# reports fall back to ephemeral /tmp and share links won't survive cold
# starts, so KV is required for a real hosted beta.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional public-endpoint gate. When set, /api/analyze-market and
# /api/waitlist require this value via the `x-scout-key` header (or ?key=).
# Leave unset for an open public beta; set it to instantly lock the API.
# SCOUT_API_KEY=

# Recommended over SCOUT_API_KEY: store only the SHA-256 hex of your key, so
# the raw secret never lives in the deployment env. Generate with:
#   node -e "const c=require('crypto');const k=c.randomBytes(24).toString('base64url');console.log('KEY',k);console.log('HASH',c.createHash('sha256').update(k).digest('hex'))"
# SCOUT_API_KEY_HASH=
